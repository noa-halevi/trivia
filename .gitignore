# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
.eggs/
build/
dist/

# Node / Next.js
node_modules/
.next/
out/

# Unused scaffold; real backend lives in server/
backend/

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables and secrets
# Safe to commit: Socket.IO client/server code, localhost defaults, event names.
# Never commit: API keys, .env files, or production SOCKET_URL overrides.
# Operational only (not gitignored): open CORS and no socket auth — tune in
# server/main.py and deployment config when you go public, not via .gitignore.
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Test and coverage output
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Type checking and tooling caches
.mypy_cache/
.ruff_cache/
.pyre/

# Jupyter
.ipynb_checkpoints/

# IDEs and OS files
.vscode/
.idea/
.DS_Store

# Logs
*.log

# SQLite temporary files
*.db-journal
*.db-shm
*.db-wal

# Accidental local SQLite copies
/trivia.db
/server/trivia.db

# Generated trivia CSV intermediates
data/*.csv
!data/final_with_hard_trivia_questions.csv
